# Create a Supabase project, then copy this file to .env (do not commit .env).
# Find these values in Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# New Supabase projects show this as the Publishable key in the Connect dialog.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Older projects may use this name instead. Use one browser-safe key, not both.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/seed-supabase.mjs. Never expose this value in a browser
# variable or commit it to Git.
SUPABASE_SECRET_KEY=your-secret-key
# Older projects may use this name instead:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URLs for each deployed FieldFlow application. These values are safe
# for frontend builds and replace localhost navigation in production.
VITE_ANALYTICS_URL=https://analytics.example.com
VITE_SCHEDULING_URL=https://scheduling.example.com
VITE_CHATBOT_URL=https://support.example.com
VITE_OPERATIONS_URL=https://operations.example.com

# Demo JSON data is automatically available only while running the local Vite
# development servers. Production builds disable mock users and JSON fallback.

# Real Supabase passwords for the two peer-testing quick-sign-in accounts on
# Scheduling's sign-in page (see scheduling/mockLogin.js). Provisioned by
# npm run provision:test-users / provision:test-sarah. These ship into the
# browser bundle by design (an auto-submit login button needs the password
# client-side) - keeping them here instead of hardcoded in source at least
# keeps them out of git history.
VITE_JOHN_TEST_PASSWORD=your-john-test-password
VITE_SARAH_TEST_PASSWORD=your-sarah-test-password
