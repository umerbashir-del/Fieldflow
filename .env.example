# Create a Supabase project, then copy this file to .env (do not commit .env).
# Find these values in Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# New Supabase projects show this as the Publishable key in the Connect dialog.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Older projects may use this name instead. Use one browser-safe key, not both.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/seed-supabase.mjs. Never expose this value in a browser
# variable or commit it to Git.
SUPABASE_SECRET_KEY=your-secret-key
# Older projects may use this name instead:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
